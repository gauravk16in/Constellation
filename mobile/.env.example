# RevenueCat public platform SDK keys. These are app-specific public keys, not secret API keys.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_replace_with_public_ios_key
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_replace_with_public_android_key

# Replace after the static legal/support pages are deployed with EAS Hosting.
EXPO_PUBLIC_CONSTELLATION_SITE_URL=https://replace-with-eas-hosting-url.example
